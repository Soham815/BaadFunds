# Leave BLANK for local dev (Vite's proxy in vite.config.js handles /api -> localhost:4000).
# For production (Netlify), set this to your deployed Render backend URL, no trailing slash:
VITE_API_URL=https://your-backend-name.onrender.com

# Baad's WhatsApp number (with country code, no + or spaces), used only on the
# admin side to build wa.me reminder links for due dates and penalties.
VITE_BAAD_WHATSAPP_NUMBER=91XXXXXXXXXX

# The live BaadFunds site link, dropped into reminder messages so she can
# tap straight through to pay.
VITE_BAADFUNDS_URL=https://your-frontend-name.netlify.app
